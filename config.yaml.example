version: 1

log:
  level: info
  output: stderr

control:
  stdio:
    enabled: false
  rest:
    enabled: true
    listen: 127.0.0.1:9090
    secret: ""
    secret-file: ""

session:
  id: default
  auto-start: true
  auto-reconnect: true

state:
  resume-file: ./state/resume.json

atrust:
  server: vpn.zju.edu.cn
  port: 443
  username: ""
  password: ""
  phone: ""
  auth-type: auth/psw
  login-domain: Radius
  update-best-nodes-interval: 30s

underlay:
  interface: ""
  auto-detect: true

routing:
  mode: rule
  internet-outbound:
    type: direct
    address: ""
    username: ""
    password: ""

dns:
  remote:
    enabled: true
    server: auto
  secondary:
    server: ""
  cache-ttl: 1h
  listen: ""
  hosts: {}

inbounds:
  socks5:
    enabled: true
    listen: 127.0.0.1:1080
    username: ""
    password: ""
  http:
    enabled: true
    listen: 127.0.0.1:1081
  tun:
    enabled: false
    name: ZJU-Portal
    address: 172.19.0.1/30
    mtu: 1400
    auto-route: false
    route-all: false
    outbound-interface: ""
    udp:
      idle-timeout: 60s
      max-flows: 4096
    dns:
      hijack: false
      fake-ip: false
      fake-ip-range: 198.18.0.0/16
